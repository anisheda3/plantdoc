  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_CeleryAnthracnose(LeafCurl)
  m_EditorClassIdentifier: 
  diseaseId: anthracnose
  diseaseName: Anthracnose (Leaf Curl)
  aiLabelAliases:
  - celery_anthracnose
  - celery anthracnose
  pathogenType: 0
  pathogen: Colletotrichum acutatum (C. fioriniae)
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: celery anthracnose'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal disease that curls celery leaves and cracks the leaf stalks.
  causes: Spores spread by rain splash and overhead irrigation in warm, wet weather;
    they come in on transplants and weeds.
  effectOnPlant: Twisted, cracked stalks are unsaleable.
  untreatedOutcome: Whole plantings can be lost in warm, wet summers.
  symptoms:
  - Leaves curl and twist downward
  - Brown, sunken lesions on leaf stalks, which crack
  - Stalks become twisted and stunted
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - wilting
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 500f6a68577f9ff4fa2caaed26a7cfa7, type: 2}
  preventionPlan: {fileID: 11400000, guid: 10494cd7934c89547b87e7ad0be2c03d, type: 2}
  simulationProfile: {fileID: 11400000, guid: e3ba1dedcf3546d4ba79dbf3e2a09938, type: 2}
  lifecycleStages:
  - Spores come in on transplants and weeds.
  - Splash carries them across the crop.
  - Leaves curl; stalks get sunken lesions.
  - Stalks crack and twist.
  conditionFactors:
  - Warm, wet weather.
  - Overhead irrigation.
  - Infected transplants.
  - Weeds round the field.
  referencePhotos: []
  lesionLabel: Brown lesion
  haloLabel: Cracked stalk
  areaLabel: Curled leaf
