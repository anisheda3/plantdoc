  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_ChilliAnthracnose(FruitRot)
  m_EditorClassIdentifier: 
  diseaseId: anthracnose
  diseaseName: Anthracnose (Fruit Rot)
  aiLabelAliases:
  - chilli_anthracnose
  - Anthracnose
  - chilli anthracnose
  - Chilli___Anthracnose
  pathogenType: 0
  pathogen: Colletotrichum capsici and C. gloeosporioides
  affectedPart: 1
  sources:
  - 'chili v2 (Roboflow) / Chilli Leaf Disease Dataset (Mendeley Data) class: Anthracnose,
    chilli anthracnose'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal rot of chilli fruit, also called die back when it kills the
    shoot tips.
  causes: Spores come in on seed and debris and spread by rain splash in warm, wet
    weather, mostly on ripening fruit.
  effectOnPlant: Rotting fruit is lost before and after harvest.
  untreatedOutcome: Can destroy much of a crop in wet seasons.
  symptoms:
  - Round, sunken, water-soaked spots on ripening fruit
  - Concentric rings of dark dots or orange spore masses in the spots
  - Shoot tips die back from the top
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: c8029871a97a26e4198e989266e0351b, type: 2}
  preventionPlan: {fileID: 11400000, guid: 5b49116580fb0c04ab2c7a497b00a4e0, type: 2}
  simulationProfile: {fileID: 11400000, guid: a741352cd98c5dd458baa5da3319e963, type: 2}
  lifecycleStages:
  - The fungus survives on seed and debris.
  - Rain splashes spores onto ripening fruit.
  - Sunken spots with rings of spores form.
  - Rotting fruit spreads it to its neighbours.
  conditionFactors:
  - Warm, wet weather.
  - Ripening fruit.
  - Overhead watering.
  - Infected seed.
  referencePhotos:
  - {fileID: 2800000, guid: dc6b0d02d2977fb4b88247673a28ac0e, type: 3}
  lesionLabel: Sunken spot
  haloLabel: Spore rings
  areaLabel: Rotting fruit
