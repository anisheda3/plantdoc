  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_RaspberryFireBlight
  m_EditorClassIdentifier: 
  diseaseId: fire_blight
  diseaseName: Fire Blight
  aiLabelAliases:
  - raspberry_fire_blight
  - raspberry fire blight
  pathogenType: 1
  pathogen: Erwinia amylovora
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: raspberry fire blight'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A bacterial disease that blackens raspberry shoot tips and leaves,
    as if scorched by fire.
  causes: Bacteria spread by rain, insects and pruning tools in warm, humid weather,
    entering through flowers and wounds.
  effectOnPlant: Blighted shoots and their fruit are lost.
  untreatedOutcome: Infection can move down the cane.
  symptoms:
  - Shoot tips wilt, blacken and bend over like a shepherd's crook
  - Leaves turn brown-black but stay on the cane
  - Fruit stays small, dry and hard
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - wilting
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 558f1ae17e578e24d91e7069b5e5e46d, type: 2}
  preventionPlan: {fileID: 11400000, guid: fcc93539d2ec7174991371e774f75e26, type: 2}
  simulationProfile: {fileID: 11400000, guid: 944ad81891280f6469357afec3d79a21, type: 2}
  lifecycleStages:
  - Bacteria survive in cankers on host plants.
  - Rain and insects carry them to flowers and shoots.
  - Shoot tips blacken and bend over.
  - Ooze from the shoots spreads them further.
  conditionFactors:
  - Warm, humid weather.
  - Hail or pruning wounds.
  - Lush growth.
  - Apple or pear trees with fire blight nearby.
  referencePhotos:
  - {fileID: 2800000, guid: 6455ebe0ac20a964394fa08012cf7dd2, type: 3}
  lesionLabel: Blackened leaf
  haloLabel: Scorched edge
  areaLabel: Blighted shoot
