MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_PeachBrownRot
  m_EditorClassIdentifier: 
  diseaseId: brown_rot
  diseaseName: Brown Rot
  aiLabelAliases:
  - peach_brown_rot
  - peach brown rot
  pathogenType: 0
  pathogen: Monilinia fructicola (and M. laxa)
  affectedPart: 1
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: peach brown rot'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal disease of stone fruit that blights blossoms and rots the
    fruit.
  causes: Spores from mummified fruit and twig cankers infect blossoms in wet spring
    weather and ripening fruit near harvest, often through wounds.
  effectOnPlant: Rotted fruit is lost, on the tree and in storage.
  untreatedOutcome: Mummies and cankers start next year's infections.
  symptoms:
  - Soft, light-brown rot spreading fast over the fruit
  - Tufts of grey-tan spores on the rot
  - Fruit shrivels into a dry mummy
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: f110ade8b5f0ad04baa1b2348e824d28, type: 2}
  preventionPlan: {fileID: 11400000, guid: d7bb3c67d2239d149add618e86cb3aa8, type: 2}
  simulationProfile: {fileID: 11400000, guid: 8a7f3b33b93985b4eb0e557160f90875, type: 2}
  lifecycleStages:
  - The fungus overwinters in mummies and cankers.
  - Spring spores blight the blossoms.
  - Near harvest, spores infect ripening fruit.
  - Rotting fruit shrivels into new mummies.
  conditionFactors:
  - Wet weather at bloom and harvest.
  - Mummies left on or under the tree.
  - Insect and hail wounds.
  - Crowded fruit.
  referencePhotos:
  - {fileID: 2800000, guid: 351f122d05eb80e42b353fd01ae75519, type: 3}
  lesionLabel: Brown rot
  haloLabel: Spore tufts
  areaLabel: Rotting fruit
