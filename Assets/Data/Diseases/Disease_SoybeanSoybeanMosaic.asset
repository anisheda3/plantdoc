MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_SoybeanSoybeanMosaic
  m_EditorClassIdentifier: 
  diseaseId: mosaic
  diseaseName: Soybean Mosaic
  aiLabelAliases:
  - soybean_mosaic
  - soybean mosaic
  pathogenType: 2
  pathogen: Soybean mosaic virus (SMV, a potyvirus)
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: soybean mosaic'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A virus disease that mottles and puckers soybean leaves and mottles
    the seed.
  causes: Spread in infected seed and by aphids that pick it up from infected plants
    within seconds.
  effectOnPlant: Yield and seed quality fall.
  untreatedOutcome: Infected seed carries it into the next crop.
  symptoms:
  - Light and dark green mosaic on young leaves
  - Leaves puckered, crinkled and curled down
  - Plants stunted; seed coats mottled brown
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: e4ec0a25f0fe6ea4f868a612386f2486, type: 2}
  preventionPlan: {fileID: 11400000, guid: dc9b869f143f1ce41becd0aa0d7fbc2e, type: 2}
  simulationProfile: {fileID: 11400000, guid: cb7c03f1ac561c042a4bb9e637a6988a, type: 2}
  lifecycleStages:
  - Infected seed gives infected seedlings.
  - Aphids carry the virus to nearby plants.
  - Young leaves mottle and pucker.
  - Seed from infected plants is mottled.
  conditionFactors:
  - Infected seed.
  - Many aphids.
  - Cool weather (symptoms show best).
  - Susceptible varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 28b580df9622d81418b1063f6c8ad624, type: 3}
  lesionLabel: Light green patch
  haloLabel: Puckered area
  areaLabel: Mottled leaf
