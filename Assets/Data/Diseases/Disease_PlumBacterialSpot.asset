  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_PlumBacterialSpot
  m_EditorClassIdentifier: 
  diseaseId: bacterial_spot
  diseaseName: Bacterial Spot
  aiLabelAliases:
  - plum_bacterial_spot
  - plum bacterial spot
  pathogenType: 1
  pathogen: Xanthomonas arboricola pv. pruni
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: plum bacterial spot'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A bacterial disease of plum and other stone fruit leaves, twigs and
    fruit.
  causes: Bacteria overwinter in twig cankers and spread by wind-driven rain in warm,
    wet weather.
  effectOnPlant: Leaves drop early and fruit is blemished.
  untreatedOutcome: Repeated defoliation weakens trees.
  symptoms:
  - Small, angular, purple-brown spots on the leaves
  - Spot centres drop out, leaving shot holes
  - Sunken dark spots on fruit
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: bd6a0b60d4510564d82bf3ac43acc208, type: 2}
  preventionPlan: {fileID: 11400000, guid: b4dd0b2442fd287478f6d5dd04c0db98, type: 2}
  simulationProfile: {fileID: 11400000, guid: c9f68e9ae9d592849b29601bddd3cfcd, type: 2}
  lifecycleStages:
  - Bacteria overwinter in twig cankers.
  - Spring rain splashes them onto leaves.
  - Angular spots form and drop out.
  - Leaves yellow and fruit is spotted.
  conditionFactors:
  - Warm, wet, windy weather.
  - Sandy soils.
  - Susceptible varieties.
  - Storms in spring.
  referencePhotos:
  - {fileID: 2800000, guid: 9ba2f3147c21e2a4881913a5517f5aad, type: 3}
  lesionLabel: Angular spot
  haloLabel: Shot hole
  areaLabel: Yellowing leaf
