  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_CarrotAlternariaLeafBlight
  m_EditorClassIdentifier: 
  diseaseId: alternaria_leaf_blight
  diseaseName: Alternaria Leaf Blight
  aiLabelAliases:
  - carrot_alternaria_leaf_blight
  - carrot alternaria leaf blight
  pathogenType: 0
  pathogen: Alternaria dauci
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: carrot alternaria leaf blight'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal blight of carrot leaves, starting on the older leaves.
  causes: Spores survive on carrot debris and seed and spread by wind and rain in
    warm, wet weather.
  effectOnPlant: Weak tops break when harvesting by machine; roots stay small.
  untreatedOutcome: Severe blight kills the foliage and cuts yield.
  symptoms:
  - Dark brown to black spots on the leaflet edges
  - Spots surrounded by yellow tissue
  - Leaflets shrivel; the whole top can die
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: ebf2a6555e5f5b649ad823001539cc6a, type: 2}
  preventionPlan: {fileID: 11400000, guid: 1c7cb56f49b89f0418c842e097244b2b, type: 2}
  simulationProfile: {fileID: 11400000, guid: ded7d93549d0dd94e993d38a1ed76e5b, type: 2}
  lifecycleStages:
  - The fungus survives on debris and seed.
  - Wind and rain carry spores to old leaves.
  - Dark spots with yellow surrounds form.
  - Leaflets shrivel and the top blights.
  conditionFactors:
  - Warm, wet weather.
  - Long leaf wetness.
  - Carrot debris.
  - Older crops.
  referencePhotos:
  - {fileID: 2800000, guid: 36741d9282684fb42869ffcfc73e27cc, type: 3}
  lesionLabel: Black spot
  haloLabel: Yellow edge
  areaLabel: Blighted leaf
