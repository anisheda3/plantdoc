  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_PeachBacterialSpot
  m_EditorClassIdentifier: 
  diseaseId: bacterial_spot
  diseaseName: Bacterial Spot
  aiLabelAliases:
  - Peach___Bacterial_spot
  - peach_bacterial_spot
  pathogenType: 1
  pathogen: 
  affectedPart: 0
  sources: []
  description: A bacterial disease (Xanthomonas arboricola pv. pruni) of peach and
    other stone fruit.
  causes: Warm, wet, windy weather; bacteria overwinter in twig cankers and spread
    by rain splash.
  effectOnPlant: Leaves drop and fruit is blemished.
  untreatedOutcome: Repeated defoliation weakens trees and makes fruit unmarketable.
  symptoms:
  - Small angular purple-brown spots on leaves
  - Spot centres drop out, leaving 'shot holes'
  - Yellow leaves that drop early
  - Pitted, cracked fruit
  supportingFeatureIds:
  - leaf_spots
  - yellowing
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 28e1672d02bdffa458b9c44a510aa82c, type: 2}
  preventionPlan: {fileID: 11400000, guid: c3705c537a9e8484c92d323d708bd52e, type: 2}
  simulationProfile: {fileID: 11400000, guid: 10d6abdb59b56d24e871a70228f364e0, type: 2}
  lifecycleStages:
  - The bacteria overwinter in twig cankers.
  - Spring rain splashes them onto young leaves.
  - Small purple-brown spots form, then drop out as shot holes.
  - Leaves yellow and drop; fruit is pitted.
  conditionFactors:
  - Warm, wet, windy weather.
  - Sandy soils and stressed trees.
  - Susceptible varieties.
  - Storms during leaf-out.
  referencePhotos:
  - {fileID: 2800000, guid: b1b1c56969bbc6c418294801d0028aca, type: 3}
  lesionLabel: Angular spot
  haloLabel: Shot hole
  areaLabel: Yellowing leaf
