  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_WheatStripeRust(YellowRust)
  m_EditorClassIdentifier: 
  diseaseId: stripe_rust
  diseaseName: Stripe Rust (Yellow Rust)
  aiLabelAliases:
  - wheat_stripe_rust
  - wheat stripe rust
  pathogenType: 0
  pathogen: Puccinia striiformis f. sp. tritici
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: wheat stripe rust'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A rust fungus of wheat that forms yellow stripes of pustules along
    the leaves in cool weather.
  causes: Spores blow long distances on the wind; dew on the leaves lets them infect,
    and new spores form within one to two weeks.
  effectOnPlant: Rusted leaves lose their green area, so grain fill suffers.
  untreatedOutcome: Severe epidemics can cut yield heavily.
  symptoms:
  - Yellow-orange pustules in long stripes between the veins
  - Stripes on leaves and heads
  - Leaves yellow and dry early
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 7a8589a6333acd54faf9a3b809c3adc1, type: 2}
  preventionPlan: {fileID: 11400000, guid: 2f0bf5eca033f64429f53ff53a71af46, type: 2}
  simulationProfile: {fileID: 11400000, guid: 3d9552ea2721a4242acd3eca528f4994, type: 2}
  lifecycleStages:
  - Spores blow in or survive on volunteers.
  - Dew lets them infect.
  - Pustules break through.
  - New spores spread every one to two weeks.
  conditionFactors:
  - Mild to warm weather.
  - Long dew.
  - Volunteer wheat nearby.
  - Susceptible varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 42f088f6761cddf42bf2512e7d8309e1, type: 3}
  lesionLabel: Rust pustule
  haloLabel: Yellow halo
  areaLabel: Rusted leaf
