  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_CoffeeBlackRot(Koleroga)
  m_EditorClassIdentifier: 
  diseaseId: black_rot
  diseaseName: Black Rot (Koleroga)
  aiLabelAliases:
  - coffee_black_rot
  - coffee black rot
  pathogenType: 0
  pathogen: Ceratobasidium noxium (syn. Corticium koleroga)
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: coffee black rot'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: 'A fungal disease of coffee in very wet, shaded plantations: leaves
    blacken and hang from the branches on fungal threads.'
  causes: Spreads in long rainy spells under heavy shade; fungal threads grow along
    the twigs from infected leaves.
  effectOnPlant: Branches lose their leaves and berries.
  untreatedOutcome: Severe in monsoon areas with heavy shade.
  symptoms:
  - Leaves turn dark brown to black and rot
  - Dead leaves hang from the twigs on white fungal threads
  - Young berries blacken and drop
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - wilting
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 186134a6ee5fbbd47aa4accfe51b81ad, type: 2}
  preventionPlan: {fileID: 11400000, guid: 6cf3a5cbedd572e4e9d6734dde652b08, type: 2}
  simulationProfile: {fileID: 11400000, guid: 5b6390c8be20f5546ae185900839e3ba, type: 2}
  lifecycleStages:
  - The fungus survives on infected twigs.
  - In long rains its threads grow onto leaves.
  - Leaves blacken and rot.
  - Dead leaves hang on threads and spread it.
  conditionFactors:
  - Monsoon rains.
  - Heavy shade.
  - High humidity.
  - Unpruned bushes.
  referencePhotos: []
  lesionLabel: Black rot
  haloLabel: Brown edge
  areaLabel: Rotting leaf
