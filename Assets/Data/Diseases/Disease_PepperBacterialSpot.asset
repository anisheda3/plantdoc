  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_PepperBacterialSpot
  m_EditorClassIdentifier: 
  diseaseId: bacterial_spot
  diseaseName: Bacterial Spot
  aiLabelAliases:
  - Pepper___Bacterial_spot
  - Pepper,_bell___Bacterial_spot
  - pepper_bacterial_spot
  - bell pepper bacterial spot
  - Bell_pepper leaf spot
  pathogenType: 1
  pathogen: 
  affectedPart: 0
  sources: []
  description: A bacterial disease (Xanthomonas) of pepper and tomato leaves and
    fruit.
  causes: Warm, wet weather; rain or overhead-water splash; infected seed or transplants.
  effectOnPlant: Spotted leaves yellow and drop; fruit is blemished.
  untreatedOutcome: Heavy leaf drop exposes fruit to sunscald and cuts yield.
  symptoms:
  - Small dark, greasy spots
  - Yellow halo around spots
  - Raised scabby spots on fruit
  supportingFeatureIds:
  - leaf_spots
  - yellowing
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 133457b5f4e525243bf66cf9a901e8ff, type: 2}
  preventionPlan: {fileID: 11400000, guid: f86bc1e250003404aa0c688b3eacb4b5, type: 2}
  simulationProfile: {fileID: 11400000, guid: a248e03d4705cae4d97862617a87c97a, type: 2}
  lifecycleStages:
  - The bacteria survive on seed, plant debris and some weeds between crops.
  - Rain splash and handling wet plants carry them onto leaves, where they enter
    through tiny openings.
  - Small water-soaked spots turn brown with yellow edges, often angular between
    the veins.
  - Spots join, leaves yellow and drop, and the bacteria can reach the fruit.
  conditionFactors:
  - "Warm, wet weather, roughly 24\u201330 \xB0C."
  - Rain or overhead watering that splashes leaves.
  - Working among or picking from wet plants.
  - Infected seed or transplants.
  referencePhotos:
  - {fileID: 2800000, guid: 1896d3cfc4b7d574f9c51a1eaad36864, type: 3}
  - {fileID: 2800000, guid: 43cb5aeab22a3af45ab66a8da9b74b72, type: 3}
  lesionLabel: Small dark spot
  haloLabel: Yellow edge
  areaLabel: Spotted area
