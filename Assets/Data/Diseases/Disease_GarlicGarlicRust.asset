  m_Name: Disease_GarlicGarlicRust
  m_EditorClassIdentifier: 
  diseaseId: rust
  diseaseName: Garlic Rust
  aiLabelAliases:
  - garlic_rust
  - garlic rust
  pathogenType: 0
  pathogen: Puccinia allii
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: garlic rust'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A rust fungus of garlic and leek leaves.
  causes: Spores blow in or survive on infected allium plants; moderate temperatures
    with dew favour it.
  effectOnPlant: Bulbs stay small and store poorly.
  untreatedOutcome: Severe rust can halve the yield.
  symptoms:
  - Small white flecks on the leaves
  - Bright orange, elongated powdery pustules
  - Leaves yellow and die early
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: e01a832a4a2f43c4fa551cb45fae3dc8, type: 2}
  preventionPlan: {fileID: 11400000, guid: 805f5419f4f1b1f49aeb8b1764a0087f, type: 2}
  simulationProfile: {fileID: 11400000, guid: 231f2c52733ad5c4ab6b441c78a73b4e, type: 2}
  lifecycleStages:
  - Spores blow in or come from volunteers.
  - Dew lets them infect.
  - Orange pustules break through.
  - New spores spread every 10-15 days.
  conditionFactors:
  - Moderate temperatures.
  - Long dew.
  - High nitrogen.
  - Volunteer alliums.
  referencePhotos:
  - {fileID: 2800000, guid: e0aa9f05ad763da49b8e65ecea1d9bfd, type: 3}
  lesionLabel: Orange pustule
  haloLabel: White fleck
  areaLabel: Rusted leaf
