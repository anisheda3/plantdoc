  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_WheatFusariumHeadBlight(Scab)
  m_EditorClassIdentifier: 
  diseaseId: head_scab
  diseaseName: Fusarium Head Blight (Scab)
  aiLabelAliases:
  - wheat_head_scab
  - wheat head scab
  pathogenType: 0
  pathogen: Fusarium graminearum (and other Fusarium spp.)
  affectedPart: 2
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: wheat head scab'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal disease of wheat heads that bleaches spikelets and contaminates
    grain with mycotoxins.
  causes: Spores from maize and wheat residue infect the heads at flowering in warm,
    wet weather.
  effectOnPlant: Yield falls and grain may contain mycotoxins (DON).
  untreatedOutcome: Contaminated grain can be rejected.
  symptoms:
  - Bleached spikelets on a still-green head
  - Pink-orange spore masses at the base of spikelets
  - Shrivelled, chalky 'tombstone' kernels
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 5ae5f09529454804c99ed63174a085df, type: 2}
  preventionPlan: {fileID: 11400000, guid: 6c11f7742a6177642853e8b2a3f69950, type: 2}
  simulationProfile: {fileID: 11400000, guid: 799e9e94cc2f086448f7090a69931700, type: 2}
  lifecycleStages:
  - The fungus survives on maize and wheat residue.
  - Spores reach the heads at flowering.
  - Spikelets bleach; pink spores form.
  - Kernels shrivel and carry mycotoxins.
  conditionFactors:
  - Warm, wet weather at flowering.
  - Maize residue.
  - Minimum tillage.
  - Susceptible varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 8ae0f75624ade074db8d6dcd32463d92, type: 3}
  lesionLabel: Bleached spikelet
  haloLabel: Pink spores
  areaLabel: Scabby head
