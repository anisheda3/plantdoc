  m_Name: Disease_SugarcaneSugarcaneRust
  m_EditorClassIdentifier: 
  diseaseId: rust
  diseaseName: Sugarcane Rust
  aiLabelAliases:
  - sugarcane_rust
  - Rust
  - sugarcane rust
  - Sugarcane___Rust
  pathogenType: 0
  pathogen: Puccinia melanocephala (brown rust) and P. kuehnii (orange rust)
  affectedPart: 0
  sources:
  - 'Sugarcane Leaf Disease Dataset (Mendeley Data) class: Rust, sugarcane rust'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: Rust fungi that streak sugarcane leaves with brown or orange pustules.
  causes: Spores blow on the wind; warm, humid weather with dew favours infection.
  effectOnPlant: Leaf area falls, reducing growth and sugar.
  untreatedOutcome: Severe rust can cut yields of susceptible varieties sharply.
  symptoms:
  - Small, elongated yellow flecks on both leaf sides
  - Flecks grow into brown or orange-brown pustules along the veins
  - Pustules merge and leaves dry early
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: f2ebb6fb971ffcc4fb85a254cd00c1ce, type: 2}
  preventionPlan: {fileID: 11400000, guid: 12f19f0d39ae683468fc33df233f5808, type: 2}
  simulationProfile: {fileID: 11400000, guid: c55cb42b5161c2d4eafd0e8b1b628a96, type: 2}
  lifecycleStages:
  - Spores blow in on the wind.
  - Dew lets them infect.
  - Yellow flecks become rust pustules along the veins.
  - New spores spread across the field.
  conditionFactors:
  - Warm, humid weather.
  - Long dew.
  - Dense crops.
  - Susceptible varieties.
  referencePhotos: []
  lesionLabel: Rust pustule
  haloLabel: Yellow fleck
  areaLabel: Rusted leaf
