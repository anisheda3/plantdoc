  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_TomatoSpiderMites
  m_EditorClassIdentifier: 
  diseaseId: spider_mites
  diseaseName: Spider Mites
  aiLabelAliases:
  - Tomato___Spider_mites Two-spotted_spider_mite
  - tomato_spider_mites
  - Tomato two spotted spider mites leaf
  pathogenType: 3
  pathogen: 
  affectedPart: 0
  sources: []
  description: 'Two-spotted spider mites (Tetranychus urticae): tiny sap-sucking
    mites, not a disease.'
  causes: Hot, dry weather and dusty, water-stressed plants; mites multiply very
    fast in heat.
  effectOnPlant: Feeding empties leaf cells; leaves bronze, dry out and drop.
  untreatedOutcome: Heavy infestations can strip and kill plants in hot weather.
  symptoms:
  - Fine pale stippling (tiny dots) on the leaves
  - Leaves turn yellow-bronze and dry
  - Fine webbing under leaves and at the tips
  supportingFeatureIds:
  - leaf_spots
  - yellowing
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: c6e456f5835bc524187db74269aab997, type: 2}
  preventionPlan: {fileID: 11400000, guid: 5898359d18b1d034f96a32d740796129, type: 2}
  simulationProfile: {fileID: 11400000, guid: 94080a2e9b3022d49be01e6104dd5f5e, type: 2}
  lifecycleStages:
  - Mites overwinter on weeds and sheltered plants.
  - In hot, dry weather they move onto crops.
  - They feed under the leaves, leaving pale dots.
  - Numbers explode in days; leaves bronze and webbing appears.
  conditionFactors:
  - Hot, dry weather.
  - Dusty, water-stressed plants.
  - Sprays that killed natural predators.
  - Sheltered spots under cover.
  referencePhotos:
  - {fileID: 2800000, guid: debbb13dc0a12fe4db77aefb916736d4, type: 3}
  lesionLabel: Stippling
  haloLabel: Bronzed area
  areaLabel: Webbed leaf
