  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_SugarcaneYellowLeafDisease
  m_EditorClassIdentifier: 
  diseaseId: yellow_leaf
  diseaseName: Yellow Leaf Disease
  aiLabelAliases:
  - sugarcane_yellow_leaf
  - Yellow
  - sugarcane yellow leaf
  - Sugarcane___Yellow_leaf
  pathogenType: 2
  pathogen: Sugarcane yellow leaf virus (SCYLV, a polerovirus)
  affectedPart: 0
  sources:
  - 'Sugarcane Leaf Disease Dataset (Mendeley Data) class: Yellow, sugarcane yellow
    leaf'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A virus disease that yellows the midrib of sugarcane leaves and stunts
    the canes.
  causes: Aphids (the sugarcane aphid) spread the virus; infected seed cane carries
    it to new fields.
  effectOnPlant: Cane and sugar yields fall.
  untreatedOutcome: Losses grow in ratoon crops.
  symptoms:
  - Bright yellow midrib on the underside of older leaves
  - Yellowing spreads into the blade from the midrib
  - Leaves dry from the tip; canes short and thin
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: f1dd8b0bfaab2414c9b193f8e9ab1bdc, type: 2}
  preventionPlan: {fileID: 11400000, guid: 53bf03ddd533ea741bdfc550321b438d, type: 2}
  simulationProfile: {fileID: 11400000, guid: 591579ad579768c4991bb4df0872edf8, type: 2}
  lifecycleStages:
  - Aphids feed on an infected plant.
  - They carry the virus to healthy canes.
  - Midribs of older leaves turn yellow.
  - Infected seed cane spreads it to new fields.
  conditionFactors:
  - Sugarcane aphids.
  - Infected seed cane.
  - Ratoon crops.
  - Susceptible varieties.
  referencePhotos: []
  lesionLabel: Yellow midrib
  haloLabel: Yellowing blade
  areaLabel: Yellow leaf
