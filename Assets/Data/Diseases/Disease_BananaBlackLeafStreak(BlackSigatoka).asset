  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_BananaBlackLeafStreak(BlackSigatoka)
  m_EditorClassIdentifier: 
  diseaseId: black_leaf_streak
  diseaseName: Black Leaf Streak (Black Sigatoka)
  aiLabelAliases:
  - banana_black_leaf_streak
  - banana black leaf streak
  pathogenType: 0
  pathogen: Pseudocercospora fijiensis
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: banana black leaf streak'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: 'The most damaging leaf disease of banana: streaks that merge and
    kill large areas of leaf.'
  causes: Wind and rain spread spores from infected leaves; frequent rain and high
    humidity favour it.
  effectOnPlant: Plants lose leaves before the bunch fills; fruit is small and ripens
    early.
  untreatedOutcome: Yield losses of 30-50% or more where it is not controlled.
  symptoms:
  - Small red-brown streaks parallel to the leaf veins
  - Streaks widen into dark brown to black spots with grey centres
  - Spots merge and large areas of leaf die
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 61d96e6d698c8b14f846addec7e97da4, type: 2}
  preventionPlan: {fileID: 11400000, guid: 4e64706b028ba9749916a5890c131e14, type: 2}
  simulationProfile: {fileID: 11400000, guid: 800afcf5c8a68104fa0c9f46a0a9076a, type: 2}
  lifecycleStages:
  - Spores come from infected leaves.
  - Wind and rain carry them to young leaves.
  - Red-brown streaks form along the veins.
  - Streaks merge and kill the leaf.
  conditionFactors:
  - Frequent rain.
  - High humidity.
  - Dense plantings.
  - Susceptible Cavendish types.
  referencePhotos:
  - {fileID: 2800000, guid: 80fed2dba100b584ebadb88f37f1ed27, type: 3}
  lesionLabel: Black streak
  haloLabel: Brown edge
  areaLabel: Dead leaf area
