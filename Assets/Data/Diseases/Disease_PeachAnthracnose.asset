  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_PeachAnthracnose
  m_EditorClassIdentifier: 
  diseaseId: anthracnose
  diseaseName: Anthracnose
  aiLabelAliases:
  - peach_anthracnose
  - peach anthracnose
  pathogenType: 0
  pathogen: Colletotrichum spp.
  affectedPart: 1
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: peach anthracnose'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal fruit rot of peach that is worst in warm, wet weather near
    harvest.
  causes: Spores spread by rain splash from infected fruit and nearby hosts; warm,
    humid weather favours it.
  effectOnPlant: Infected fruit is lost, before or after harvest.
  untreatedOutcome: Mummified fruit carries the fungus to next season.
  symptoms:
  - Round, sunken, tan to brown spots on the fruit
  - Rings of orange-pink spore masses in the spots
  - Fruit rots and mummifies
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 6c80e9f4aa5c68243aac6dc386e3c68a, type: 2}
  preventionPlan: {fileID: 11400000, guid: 600217757c55ac7479de7b9735fa43c5, type: 2}
  simulationProfile: {fileID: 11400000, guid: 3df89659bed192c4dbbbd36a870243b1, type: 2}
  lifecycleStages:
  - The fungus survives on mummies and twigs.
  - Rain splashes spores onto the fruit.
  - Sunken spots with spore rings form as fruit ripens.
  - Rotting fruit spreads it to its neighbours.
  conditionFactors:
  - Warm, wet weather.
  - Fruit near harvest.
  - Mummies left in the tree.
  - Wounds on the fruit.
  referencePhotos: []
  lesionLabel: Sunken spot
  haloLabel: Spore rings
  areaLabel: Rotting fruit
