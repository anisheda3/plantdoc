  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_BroccoliAlternariaLeafSpot
  m_EditorClassIdentifier: 
  diseaseId: alternaria_leaf_spot
  diseaseName: Alternaria Leaf Spot
  aiLabelAliases:
  - broccoli_alternaria_leaf_spot
  - broccoli alternaria leaf spot
  pathogenType: 0
  pathogen: Alternaria brassicicola and A. brassicae
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: broccoli alternaria leaf spot'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal leaf spot of broccoli and other brassicas with dark, target-like
    spots.
  causes: Spores survive on brassica debris and seed and spread by wind and rain
    in warm, wet weather.
  effectOnPlant: Spotted outer leaves and blemished heads reduce quality.
  untreatedOutcome: Severe spotting reaches the harvested part.
  symptoms:
  - Round brown to black spots with concentric rings
  - A yellow halo round the spots
  - Dark spots on heads and stems too
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: a1e4046636dde71449536b37efbfe6bd, type: 2}
  preventionPlan: {fileID: 11400000, guid: 77716d1e1cb9b7748a32dc7604a8ce57, type: 2}
  simulationProfile: {fileID: 11400000, guid: 6fe88233ede3f334e8b5aa8ae207c382, type: 2}
  lifecycleStages:
  - The fungus survives on debris and seed.
  - Wind and rain carry spores to leaves.
  - Dark ringed spots with halos form.
  - Spots reach the heads in wet weather.
  conditionFactors:
  - Warm, wet weather.
  - Brassica debris.
  - Overhead watering.
  - Infected seed.
  referencePhotos:
  - {fileID: 2800000, guid: 466f8856a21621b45bd7590906bae4ea, type: 3}
  lesionLabel: Target spot
  haloLabel: Yellow halo
  areaLabel: Spotted leaf
