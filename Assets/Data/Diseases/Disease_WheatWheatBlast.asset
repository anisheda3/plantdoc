  m_Name: Disease_WheatWheatBlast
  m_EditorClassIdentifier: 
  diseaseId: blast
  diseaseName: Wheat Blast
  aiLabelAliases:
  - wheat_blast
  - Wheat___Blast
  - wheat blast
  pathogenType: 0
  pathogen: Magnaporthe oryzae pathotype Triticum
  affectedPart: 2
  sources:
  - 'CropScan XR model class: Wheat___Blast, wheat blast'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fast, destructive disease of wheat heads, first seen in Brazil and
    since 2016 in Bangladesh and Zambia.
  causes: Spores spread by wind and on seed; warm, wet weather at heading lets them
    infect the rachis and kill the head above it.
  effectOnPlant: Bleached heads give little or no grain.
  untreatedOutcome: Outbreaks can destroy whole fields within days.
  symptoms:
  - Heads bleached white above the infection point, while the lower part stays green
  - A dark, shiny lesion on the rachis where it was infected
  - Shrivelled or no grain in the bleached part
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 8961aafe631a09f418511c6dee991924, type: 2}
  preventionPlan: {fileID: 11400000, guid: 636a0c9a2592f084cad1588334aa7132, type: 2}
  simulationProfile: {fileID: 11400000, guid: bc221fd3c69179447858327263723b8f, type: 2}
  lifecycleStages:
  - Spores come in on seed or wind.
  - Warm, wet weather at heading lets them infect.
  - A lesion on the rachis cuts off the head above it.
  - The head bleaches and sets little grain.
  conditionFactors:
  - Warm, wet weather at heading.
  - Infected seed.
  - Late sowing.
  - Susceptible varieties.
  referencePhotos: []
  lesionLabel: Bleached head
  haloLabel: Dark rachis lesion
  areaLabel: Blasted head
