  m_Name: Disease_TobaccoBrownSpot
  m_EditorClassIdentifier: 
  diseaseId: brown_spot
  diseaseName: Brown Spot
  aiLabelAliases:
  - tobacco_brown_spot
  - tobacco brown spot
  pathogenType: 0
  pathogen: Alternaria alternata
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: tobacco brown spot'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal leaf spot of mature tobacco leaves with ringed brown spots.
  causes: Spores survive on debris and spread by wind; mature, lower leaves in warm,
    wet weather are infected.
  effectOnPlant: Leaf quality falls.
  untreatedOutcome: Heavy losses in warm, wet seasons.
  symptoms:
  - Round brown spots with concentric rings
  - A yellow halo round each spot
  - Spots merge on mature leaves
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: ad013c3ff3c34a0478de8e0daba1b0f5, type: 2}
  preventionPlan: {fileID: 11400000, guid: 03624289629db854993acde2d5c5f7e9, type: 2}
  simulationProfile: {fileID: 11400000, guid: e6bba832b189ab244b26dbbdaeedbd11, type: 2}
  lifecycleStages:
  - The fungus survives on debris.
  - Wind carries spores to mature leaves.
  - Brown ringed spots with halos form.
  - Spots merge as leaves mature.
  conditionFactors:
  - Warm, wet weather.
  - Mature leaves.
  - Debris in the field.
  - Late harvest.
  referencePhotos:
  - {fileID: 2800000, guid: 9338e486afea7cb41a73a87d80481363, type: 3}
  lesionLabel: Ringed spot
  haloLabel: Yellow halo
  areaLabel: Spotted leaf
