  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_CeleryEarlyBlight
  m_EditorClassIdentifier: 
  diseaseId: early_blight
  diseaseName: Early Blight
  aiLabelAliases:
  - celery_early_blight
  - celery early blight
  pathogenType: 0
  pathogen: Cercospora apii
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: celery early blight'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: 'Cercospora early blight: a fungal leaf spot of celery in warm, humid
    weather.'
  causes: Spores survive on debris and seed and spread by wind and splash; warm,
    humid weather with dew favours it.
  effectOnPlant: Spotted leaves and stalks lower quality and yield.
  untreatedOutcome: Severe blight destroys the leaves.
  symptoms:
  - Small yellow spots that grow into tan to grey lesions
  - Lesions angular, with a grey bloom of spores in humid weather
  - Lesions merge and leaflets die; stalks can be spotted
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 1d695f4fa11870e45aa4f601054860ea, type: 2}
  preventionPlan: {fileID: 11400000, guid: 9efea90adb7a2fc4e8dddc29c0a3b80f, type: 2}
  simulationProfile: {fileID: 11400000, guid: c9d4c19bdbeb73948b0cef3f4a586ea8, type: 2}
  lifecycleStages:
  - The fungus survives on debris and seed.
  - Warm, humid weather spreads spores.
  - Yellow spots become tan lesions.
  - Lesions merge and leaves die.
  conditionFactors:
  - "Warm (25-30 \xB0C), humid weather."
  - Long dew.
  - Celery debris.
  - Infected seed.
  referencePhotos:
  - {fileID: 2800000, guid: 8c61c953c0f7d8c4783c6022fe3b4a0a, type: 3}
  lesionLabel: Tan lesion
  haloLabel: Yellow edge
  areaLabel: Blighted leaf
