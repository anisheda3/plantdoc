  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_BeanHaloBlight
  m_EditorClassIdentifier: 
  diseaseId: halo_blight
  diseaseName: Halo Blight
  aiLabelAliases:
  - bean_halo_blight
  - bean halo blight
  pathogenType: 1
  pathogen: Pseudomonas savastanoi pv. phaseolicola
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: bean halo blight'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A bacterial disease of beans with small brown spots inside wide yellow-green
    halos.
  causes: The bacteria come in on infected seed and spread by rain splash, wind and
    handling in cool, wet weather.
  effectOnPlant: Leaves and pods are spotted; yield and seed quality fall.
  untreatedOutcome: Infected seed carries it into the next crop.
  symptoms:
  - Small water-soaked spots that turn brown
  - A wide yellow-green halo round each spot
  - Greasy spots on pods; young leaves yellow overall
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 86df28271c81584488b0878ba15c191d, type: 2}
  preventionPlan: {fileID: 11400000, guid: 3e7c486b3cacded48a1381f7a0a683c1, type: 2}
  simulationProfile: {fileID: 11400000, guid: 125dcc233fc2dad4b84cb88f4a1d389c, type: 2}
  lifecycleStages:
  - Bacteria come in on seed.
  - Rain splash spreads them.
  - Brown spots with wide halos form.
  - Pods and seed are infected.
  conditionFactors:
  - "Cool (16-20 \xB0C), wet weather."
  - Infected seed.
  - Handling wet plants.
  - Overhead watering.
  referencePhotos: []
  lesionLabel: Brown spot
  haloLabel: Yellow halo
  areaLabel: Yellowing leaf
