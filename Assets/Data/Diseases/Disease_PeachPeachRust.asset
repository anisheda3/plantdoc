  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_PeachPeachRust
  m_EditorClassIdentifier: 
  diseaseId: rust
  diseaseName: Peach Rust
  aiLabelAliases:
  - peach_rust
  - peach rust
  pathogenType: 0
  pathogen: Tranzschelia discolor
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: peach rust'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A rust fungus of peach and other stone fruit leaves.
  causes: Spores blow in or survive in twig cankers; long leaf wetness in warm weather
    lets them infect.
  effectOnPlant: Early leaf fall weakens the tree for next year.
  untreatedOutcome: Repeated defoliation reduces vigour and fruit size.
  symptoms:
  - Small, angular yellow spots on the upper leaf
  - Rusty brown powdery pustules underneath
  - Leaves yellow and drop late in the season
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 4b226e8837054fc41bb1ec9d1b44c5ac, type: 2}
  preventionPlan: {fileID: 11400000, guid: b038455c830d28a409194a40e75ce29b, type: 2}
  simulationProfile: {fileID: 11400000, guid: 0f58d0264abc9c848836db3a83b83899, type: 2}
  lifecycleStages:
  - Spores survive in twig cankers or blow in.
  - Wet, warm weather lets them infect leaves.
  - Yellow spots form, with rust pustules beneath.
  - New spores spread through the tree.
  conditionFactors:
  - Warm, humid weather.
  - Long leaf wetness.
  - Twig cankers.
  - Late summer.
  referencePhotos:
  - {fileID: 2800000, guid: 264d042d7b32c3d4aabf5a62203132f8, type: 3}
  lesionLabel: Yellow spot
  haloLabel: Rust pustule
  areaLabel: Yellowing leaf
