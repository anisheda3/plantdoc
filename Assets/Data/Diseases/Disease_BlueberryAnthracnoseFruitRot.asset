  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_BlueberryAnthracnoseFruitRot
  m_EditorClassIdentifier: 
  diseaseId: anthracnose
  diseaseName: Anthracnose Fruit Rot
  aiLabelAliases:
  - blueberry_anthracnose
  - blueberry anthracnose
  pathogenType: 0
  pathogen: Colletotrichum fioriniae (and C. acutatum)
  affectedPart: 1
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: blueberry anthracnose'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal ripe rot of blueberries that shows as the fruit ripens or
    after picking.
  causes: The fungus overwinters on twigs and buds; rain splashes spores onto green
    berries, which stay symptomless until they ripen.
  effectOnPlant: Ripe fruit rots on the bush and in storage.
  untreatedOutcome: Losses grow each wet year as the fungus builds up on the twigs.
  symptoms:
  - Sunken, softening berries at the blossom end
  - Orange to salmon spore masses on the berries
  - Berries shrivel; rot spreads in stored fruit
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 9f932a5467d291f4481264ec3171229f, type: 2}
  preventionPlan: {fileID: 11400000, guid: 03bd3f1bf9e048842bb7726b016d1ccf, type: 2}
  simulationProfile: {fileID: 11400000, guid: 64669d690dad65d43b6911bdb350f336, type: 2}
  lifecycleStages:
  - Spores overwinter on twigs and buds.
  - Rain splashes them onto green berries.
  - Infection stays hidden until the fruit ripens.
  - Ripe berries soften and ooze orange spores.
  conditionFactors:
  - Warm, wet weather at harvest.
  - Infrequent picking.
  - Dense, unpruned bushes.
  - Susceptible varieties.
  referencePhotos: []
  lesionLabel: Sunken berry
  haloLabel: Spore mass
  areaLabel: Rotting fruit
