  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_LettuceLettuceMosaic
  m_EditorClassIdentifier: 
  diseaseId: mosaic_virus
  diseaseName: Lettuce Mosaic
  aiLabelAliases:
  - lettuce_mosaic_virus
  - lettuce mosaic virus
  pathogenType: 2
  pathogen: Lettuce mosaic virus (LMV, a potyvirus)
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: lettuce mosaic virus'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A virus disease that mottles and distorts lettuce and stops heads
    forming.
  causes: Carried in seed and spread by aphids from infected plants.
  effectOnPlant: Plants are unsaleable.
  untreatedOutcome: Infected seed spreads it to new plantings.
  symptoms:
  - Light and dark green mottling on the leaves
  - Leaves distorted and puckered, with clear veins
  - Plants stunted; heads fail to form
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 4940f32ee66ce114595d09dde1456118, type: 2}
  preventionPlan: {fileID: 11400000, guid: 7d92139b3b0ad2343b4efe6d82d16299, type: 2}
  simulationProfile: {fileID: 11400000, guid: e2c529fd39092904580a72dc50ab17b0, type: 2}
  lifecycleStages:
  - Infected seed gives infected seedlings.
  - Aphids spread the virus.
  - Leaves mottle and pucker.
  - Heads fail to form.
  conditionFactors:
  - Infected seed.
  - Aphids.
  - Old lettuce crops nearby.
  - Weeds.
  referencePhotos:
  - {fileID: 2800000, guid: 1a1c69ac8b6e9c24eb5125254b5458e5, type: 3}
  lesionLabel: Mottled patch
  haloLabel: Puckered area
  areaLabel: Mottled leaf
