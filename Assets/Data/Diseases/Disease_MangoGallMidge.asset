  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_MangoGallMidge
  m_EditorClassIdentifier: 
  diseaseId: gall_midge
  diseaseName: Gall Midge
  aiLabelAliases:
  - mango_gall_midge
  - Gall Midge
  - mango gall midge
  - Mango___Gall_midge
  pathogenType: 3
  pathogen: Procontarinia spp. (mango gall midges)
  affectedPart: 0
  sources:
  - 'MangoLeafBD (Mendeley Data) class: Gall Midge, mango gall midge'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: Tiny flies whose larvae form small raised galls on mango leaves.
  causes: Midges lay eggs in young leaves; each larva makes a small wart-like gall
    as it feeds.
  effectOnPlant: Galled leaves photosynthesise less and drop.
  untreatedOutcome: Heavy infestations weaken young trees and new flushes.
  symptoms:
  - Many small raised, wart-like galls on the leaf, 3-4 mm
  - Galls dark brown to black, sometimes with a pale halo
  - Heavily galled leaves curl and drop early
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: b66b86159ed83964cadd863ffcd2eb92, type: 2}
  preventionPlan: {fileID: 11400000, guid: 6b8f2f456a8b3cc4abfb96d13811d64b, type: 2}
  simulationProfile: {fileID: 11400000, guid: 401269b5be9c2ae409c4ed2ef1e92bad, type: 2}
  lifecycleStages:
  - Midges lay eggs in young leaves.
  - Larvae feed inside, forming galls.
  - Mature larvae drop to the soil.
  - They pupate and emerge for the next flush.
  conditionFactors:
  - Frequent new flushes.
  - Humid weather.
  - Undisturbed soil under trees.
  - Susceptible varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 52c1a22ac0d61534f9b29ce4174b40a6, type: 3}
  lesionLabel: Leaf gall
  haloLabel: Pale halo
  areaLabel: Galled leaf
