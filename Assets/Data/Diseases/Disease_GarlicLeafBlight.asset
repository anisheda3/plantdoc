  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_GarlicLeafBlight
  m_EditorClassIdentifier: 
  diseaseId: leaf_blight
  diseaseName: Leaf Blight
  aiLabelAliases:
  - garlic_leaf_blight
  - garlic leaf blight
  pathogenType: 0
  pathogen: Stemphylium vesicarium (often with Alternaria porri, purple blotch)
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: garlic leaf blight'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal blight of garlic leaves that starts on the leaf tips and
    on damaged tissue.
  causes: Spores survive on debris and spread by wind in warm, humid weather; leaves
    damaged by thrips, hail or sun are infected first.
  effectOnPlant: Leaves die early, so bulbs stay small.
  untreatedOutcome: Severe blight cuts yield and storage quality.
  symptoms:
  - Small yellow to tan, water-soaked spots on the leaves
  - Spots grow into long tan to brown lesions, often purple-edged
  - Leaf tips die back; lesions turn dark with spores
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: b3ad64053def0504c917727cdce1c0c8, type: 2}
  preventionPlan: {fileID: 11400000, guid: 8cff0fb9252ab434c9c8e75aac0cecd1, type: 2}
  simulationProfile: {fileID: 11400000, guid: c80a307800f0f434db3d19b65022c8d2, type: 2}
  lifecycleStages:
  - The fungus survives on debris.
  - Warm, humid weather spreads spores.
  - Spots start on tips and wounds.
  - Lesions lengthen and the leaf dies back.
  conditionFactors:
  - Warm, humid weather.
  - Long leaf wetness.
  - Thrips damage.
  - Debris from onions or garlic.
  referencePhotos: []
  lesionLabel: Tan lesion
  haloLabel: Purple edge
  areaLabel: Blighted leaf
