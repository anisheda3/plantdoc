  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_PepperPowderyMildew
  m_EditorClassIdentifier: 
  diseaseId: powdery_mildew
  diseaseName: Powdery Mildew
  aiLabelAliases:
  - Pepper___Powdery_mildew
  - pepper_powdery_mildew
  - bell pepper powdery mildew
  pathogenType: 0
  pathogen: 
  affectedPart: 0
  sources: []
  description: A fungal disease (Leveillula taurica) that grows inside and under
    pepper leaves.
  causes: Warm, dry days with humid nights; crowded plants.
  effectOnPlant: Reduces leaf area and causes leaf drop.
  untreatedOutcome: Severe leaf loss leaves fruit sunburnt and small.
  symptoms:
  - Yellow patches on the upper leaf
  - White powdery growth underneath
  - Leaves curl and drop
  supportingFeatureIds:
  - leaf_spots
  - yellowing
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 3d7a6cd9df301b34e8db61e96faf3732, type: 2}
  preventionPlan: {fileID: 11400000, guid: f98a4997874a3b64a97dc114113f6351, type: 2}
  simulationProfile: {fileID: 11400000, guid: 9561f9327eab66a41b1e458194858f43, type: 2}
  lifecycleStages:
  - The fungus survives on crop remains and on nearby host plants.
  - Wind-blown spores land on leaves; unlike many fungi they do not need wet leaves.
  - Pale yellow patches show on the upper side, with white powdery growth underneath.
  - Leaves curl and drop, which can expose the fruit to sunburn.
  conditionFactors:
  - Warm days and cooler nights with moderate humidity.
  - 'Dry leaves are enough: rain is not required.'
  - Crowded or shaded plants.
  - Older leaves later in the season.
  referencePhotos: []
  lesionLabel: Pale patch
  haloLabel: Yellow patch
  areaLabel: Powdery area
