  m_Name: Disease_RaspberryYellowRust
  m_EditorClassIdentifier: 
  diseaseId: yellow_rust
  diseaseName: Yellow Rust
  aiLabelAliases:
  - raspberry_yellow_rust
  - raspberry yellow rust
  pathogenType: 0
  pathogen: Phragmidium rubi-idaei
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: raspberry yellow rust'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A rust fungus of raspberry leaves and canes.
  causes: Spores overwinter on fallen leaves and canes and infect new leaves in spring;
    summer spores spread in humid weather.
  effectOnPlant: Leaves fall early, weakening the canes.
  untreatedOutcome: Severe years reduce the next crop.
  symptoms:
  - Small yellow spots on the upper leaf
  - Bright yellow-orange pustules on the underside
  - Pustules turn black late in the season; leaves drop
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 479ba34fe4214db4fb1dea778798632d, type: 2}
  preventionPlan: {fileID: 11400000, guid: eb4b804c6cf4f05479836fff0e8f2b2d, type: 2}
  simulationProfile: {fileID: 11400000, guid: 9a1d46996635cc049bcab4c171940a31, type: 2}
  lifecycleStages:
  - Spores overwinter on leaves and canes.
  - In spring they infect new leaves.
  - Orange pustules form underneath.
  - Black winter spores form in autumn.
  conditionFactors:
  - Humid weather.
  - Fallen leaves left.
  - Dense canes.
  - Susceptible varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 298081075cbf135478878c22a3ae2136, type: 3}
  lesionLabel: Yellow pustule
  haloLabel: Pale spot
  areaLabel: Rusted leaf
