  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_BeanBeanCommonMosaic
  m_EditorClassIdentifier: 
  diseaseId: mosaic_virus
  diseaseName: Bean Common Mosaic
  aiLabelAliases:
  - bean_mosaic_virus
  - bean mosaic virus
  pathogenType: 2
  pathogen: Bean common mosaic virus (BCMV, a potyvirus)
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: bean mosaic virus'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A virus disease that mottles and curls bean leaves.
  causes: Carried in seed and spread by aphids that probe infected plants.
  effectOnPlant: Yield falls.
  untreatedOutcome: Infected seed spreads it to the next crop.
  symptoms:
  - Light and dark green mosaic on the leaves
  - Leaves puckered, curled down and narrow
  - Stunted plants with fewer pods
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 248fc50a19f6bd643b84e267238a0493, type: 2}
  preventionPlan: {fileID: 11400000, guid: b11fa69b18da67145befbc0e138982c6, type: 2}
  simulationProfile: {fileID: 11400000, guid: 73aca9af7f8e74f41b3d334af86dc88e, type: 2}
  lifecycleStages:
  - Infected seed gives infected seedlings.
  - Aphids carry the virus onward.
  - Leaves mottle and curl.
  - Seed from infected plants carries it.
  conditionFactors:
  - Infected seed.
  - Aphids.
  - Weeds round the crop.
  - Susceptible varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 2fbd18c6d78c0fc4a918bb41e5bba157, type: 3}
  lesionLabel: Light green patch
  haloLabel: Puckered area
  areaLabel: Mottled leaf
