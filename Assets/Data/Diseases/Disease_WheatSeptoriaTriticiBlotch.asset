  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_WheatSeptoriaTriticiBlotch
  m_EditorClassIdentifier: 
  diseaseId: septoria_blotch
  diseaseName: Septoria Tritici Blotch
  aiLabelAliases:
  - wheat_septoria_blotch
  - wheat septoria blotch
  pathogenType: 0
  pathogen: Zymoseptoria tritici
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: wheat septoria blotch'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: 'The most common leaf disease of wheat in wet climates: long brown
    blotches dotted with black spore bodies.'
  causes: Spores from residue and the lower leaves are splashed upward by rain.
  effectOnPlant: Upper leaves die early and grain fill falls.
  untreatedOutcome: Yield losses in wet seasons.
  symptoms:
  - Yellow flecks that become long brown blotches between the veins
  - Tiny black dots (spore bodies) in the blotches
  - Blotches merge and leaves die from the bottom up
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 76bbcf22cd5857345b2989af2195961d, type: 2}
  preventionPlan: {fileID: 11400000, guid: 7156eeaf30b3a7640982f5447af8e3d5, type: 2}
  simulationProfile: {fileID: 11400000, guid: 2b18d8c63f0e1684491a7f3c454c67be, type: 2}
  lifecycleStages:
  - The fungus survives on residue.
  - Rain splashes spores up the plant.
  - Brown blotches with black dots form.
  - Leaves die from the bottom up.
  conditionFactors:
  - Frequent rain.
  - Mild weather.
  - Early-sown crops.
  - Susceptible varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 3724f252975eeff43a735eeaf4e7a900, type: 3}
  lesionLabel: Brown blotch
  haloLabel: Black dots
  areaLabel: Blotched leaf
