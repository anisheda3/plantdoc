MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_BlueberryMummyBerry
  m_EditorClassIdentifier: 
  diseaseId: mummy_berry
  diseaseName: Mummy Berry
  aiLabelAliases:
  - blueberry_mummy_berry
  - blueberry mummy berry
  pathogenType: 0
  pathogen: Monilinia vaccinii-corymbosi
  affectedPart: 1
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: blueberry mummy berry'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal disease that withers shoots in spring and turns the berries
    into hard, grey 'mummies'.
  causes: Mummified berries on the ground grow small cup fungi in spring; their spores
    blight young shoots, which then infect the flowers.
  effectOnPlant: Infected berries are lost.
  untreatedOutcome: Mummies on the ground start the next spring's epidemic.
  symptoms:
  - Young leaves and shoots wilt and turn brown ('shoot strike')
  - Infected berries turn cream to pink, then shrivel
  - Hard, grey, pumpkin-shaped mummies drop to the ground
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: e32e4ba215b64a546b3e792251a331da, type: 2}
  preventionPlan: {fileID: 11400000, guid: bce0ae581ef9b23418039c522fcb7bd8, type: 2}
  simulationProfile: {fileID: 11400000, guid: 95b6b0e36b6e4b14db9e68f44558434c, type: 2}
  lifecycleStages:
  - Mummies on the ground grow cup fungi in spring.
  - Their spores blight young shoots.
  - Spores from the shoots infect the flowers.
  - Berries become mummies and drop.
  conditionFactors:
  - Wet springs.
  - Mummies left on the ground.
  - Bare soil under bushes.
  - Susceptible varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 9cc7d281973264841b21eb7266858fbc, type: 3}
  lesionLabel: Mummified berry
  haloLabel: Pink berry
  areaLabel: Infected cluster
