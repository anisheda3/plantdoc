  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_BananaPanamaDisease(FusariumWilt)
  m_EditorClassIdentifier: 
  diseaseId: panama_disease
  diseaseName: Panama Disease (Fusarium Wilt)
  aiLabelAliases:
  - banana_panama_disease
  - banana panama disease
  pathogenType: 0
  pathogen: Fusarium oxysporum f. sp. cubense (incl. Tropical Race 4)
  affectedPart: 4
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: banana panama disease'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A soil-borne fungal wilt that blocks the water vessels of banana plants;
    Tropical Race 4 also kills Cavendish.
  causes: The fungus lives in the soil for decades and enters through the roots;
    it spreads in soil on boots, tools, vehicles, water and infected planting material.
  effectOnPlant: Infected plants die without a bunch.
  untreatedOutcome: The soil stays infested for decades; the disease spreads field
    to field.
  symptoms:
  - Older leaves yellow from the margins inward
  - Leaves collapse at the petiole and hang down round the pseudostem like a skirt
  - Brown to red-brown streaks inside the pseudostem
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  - wilting
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: bf9f06a0d38143d41976242021f9104b, type: 2}
  preventionPlan: {fileID: 11400000, guid: caf19120cdb3be04c9536c3b1a30d6f8, type: 2}
  simulationProfile: {fileID: 11400000, guid: 12d949ac3d73ca44a9a85606e220b89f, type: 2}
  lifecycleStages:
  - The fungus lives in the soil for decades.
  - It enters through the roots.
  - It blocks the water vessels.
  - Leaves yellow, collapse and the plant dies.
  conditionFactors:
  - Infested soil.
  - Moving soil and plants.
  - Poor drainage.
  - Susceptible cultivars.
  referencePhotos:
  - {fileID: 2800000, guid: 15e5655be5feb6d49b50398732942c56, type: 3}
  lesionLabel: Brown margin
  haloLabel: Yellow edge
  areaLabel: Collapsed leaves
