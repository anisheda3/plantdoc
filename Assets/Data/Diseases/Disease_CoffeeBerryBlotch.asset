  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_CoffeeBerryBlotch
  m_EditorClassIdentifier: 
  diseaseId: berry_blotch
  diseaseName: Berry Blotch
  aiLabelAliases:
  - coffee_berry_blotch
  - coffee berry blotch
  pathogenType: 0
  pathogen: Cercospora coffeicola
  affectedPart: 1
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: coffee berry blotch'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: 'The berry phase of brown eye spot: dark, sunken blotches on coffee
    cherries.'
  causes: Spores spread by wind and rain; stressed, poorly fed bushes in full sun
    are most affected.
  effectOnPlant: Berries lose quality and the beans can be damaged.
  untreatedOutcome: Losses rise on stressed, under-fed bushes.
  symptoms:
  - Brown, sunken blotches on the cherries, often on the sunny side
  - Blotches turn dark and dry the pulp
  - Affected cherries ripen early or drop
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 7c61633d0ae54244db3587df4e5d974b, type: 2}
  preventionPlan: {fileID: 11400000, guid: ce56ef3e223405f49ac3376c6e63a440, type: 2}
  simulationProfile: {fileID: 11400000, guid: 2d1eae8bcd8718043b6924635ab48176, type: 2}
  lifecycleStages:
  - Spores come from leaf and berry spots.
  - Wind and rain carry them to the cherries.
  - Sunken brown blotches form.
  - Cherries dry or drop early.
  conditionFactors:
  - Full sun.
  - Poor nutrition.
  - Wet weather at berry development.
  - Stressed bushes.
  referencePhotos:
  - {fileID: 2800000, guid: 42d21fa271ef952409d80fa72f7e90cd, type: 3}
  lesionLabel: Dark blotch
  haloLabel: Sunken edge
  areaLabel: Blotched cherry
