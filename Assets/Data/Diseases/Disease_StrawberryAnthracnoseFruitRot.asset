  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_StrawberryAnthracnoseFruitRot
  m_EditorClassIdentifier: 
  diseaseId: anthracnose
  diseaseName: Anthracnose Fruit Rot
  aiLabelAliases:
  - strawberry_anthracnose
  - strawberry anthracnose
  pathogenType: 0
  pathogen: Colletotrichum acutatum (and related species)
  affectedPart: 1
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: strawberry anthracnose'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A fungal disease of strawberry that rots the fruit and can attack
    runners and crowns.
  causes: Spores come in on infected transplants and spread by rain splash and overhead
    watering in warm weather.
  effectOnPlant: Infected fruit is lost, sometimes most of a picking.
  untreatedOutcome: The fungus builds up in the planting and on mummies.
  symptoms:
  - Round, sunken, tan to dark brown spots on the fruit
  - Orange-pink spore masses in the spots in wet weather
  - Fruit dries into a dark mummy
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: f59db327b11094441b041a306c491db1, type: 2}
  preventionPlan: {fileID: 11400000, guid: 09b451205f6c0e747bb372748b87d1c0, type: 2}
  simulationProfile: {fileID: 11400000, guid: f4e5fe894b96abe4993241e019005b6d, type: 2}
  lifecycleStages:
  - The fungus arrives on infected transplants.
  - Rain and irrigation splash spores onto fruit.
  - Sunken spots with orange spore masses form.
  - Mummies carry it on.
  conditionFactors:
  - "Warm (25-30 \xB0C), wet weather."
  - Overhead watering.
  - Infected transplants.
  - Ripening fruit.
  referencePhotos: []
  lesionLabel: Sunken spot
  haloLabel: Spore mass
  areaLabel: Rotting fruit
