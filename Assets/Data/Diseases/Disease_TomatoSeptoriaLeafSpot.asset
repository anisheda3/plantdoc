  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_TomatoSeptoriaLeafSpot
  m_EditorClassIdentifier: 
  diseaseId: septoria_leaf_spot
  diseaseName: Septoria Leaf Spot
  aiLabelAliases:
  - Tomato___Septoria_leaf_spot
  - tomato_septoria_leaf_spot
  - tomato septoria leaf spot
  - Tomato Septoria leaf spot
  pathogenType: 0
  pathogen: 
  affectedPart: 0
  sources: []
  description: A fungal disease (Septoria lycopersici) that covers tomato leaves
    in many small spots.
  causes: Warm, wet weather; spores splash up from infected debris and soil onto
    the lower leaves.
  effectOnPlant: Spotted leaves yellow and drop from the bottom of the plant upward.
  untreatedOutcome: Severe defoliation weakens the plant and leaves fruit exposed
    to sunscald.
  symptoms:
  - Many small round spots with grey-tan centres
  - Dark borders round the spots
  - Tiny black dots in the spot centres
  - Lower leaves first
  supportingFeatureIds:
  - leaf_spots
  - yellowing
  - leaf_color
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: fbf3b559bcd4a2a4cb5af9b7ac17e467, type: 2}
  preventionPlan: {fileID: 11400000, guid: d6c016fc9592cc147b2e731b79d13921, type: 2}
  simulationProfile: {fileID: 11400000, guid: 93858d071dd628e4c8e650ba1a03fde1, type: 2}
  lifecycleStages:
  - The fungus survives on old tomato debris and some weeds.
  - Rain splashes spores onto the lowest leaves.
  - Many small spots with grey centres and black dots appear.
  - Leaves yellow and drop from the bottom up.
  conditionFactors:
  - Warm, wet weather.
  - Splashing rain or irrigation.
  - Debris left in the bed.
  - Lower leaves touching the soil.
  referencePhotos:
  - {fileID: 2800000, guid: 1b91254ada7e85f48858d4e7c9fa1add, type: 3}
  lesionLabel: Grey-centred spot
  haloLabel: Dark border
  areaLabel: Spotted leaf
