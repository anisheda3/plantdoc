  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_CoffeeCoffeeLeafRust
  m_EditorClassIdentifier: 
  diseaseId: leaf_rust
  diseaseName: Coffee Leaf Rust
  aiLabelAliases:
  - coffee_leaf_rust
  - coffee leaf rust
  pathogenType: 0
  pathogen: Hemileia vastatrix
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: coffee leaf rust'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: 'The most important disease of Arabica coffee: orange powdery rust
    under the leaves and heavy leaf loss.'
  causes: "Spores spread by wind, rain and people; they need liquid water on the
    leaf to infect, at 21-25 \xB0C."
  effectOnPlant: Leaf loss cuts the next year's crop.
  untreatedOutcome: Severe epidemics have devastated coffee regions.
  symptoms:
  - Small pale yellow spots on the upper leaf
  - Orange-yellow powdery spores on the underside
  - Spots merge; leaves drop, leaving bare branches
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: c5c9fe66b906e9240b91769ddbb1f8be, type: 2}
  preventionPlan: {fileID: 11400000, guid: 59dfd6c56ad1b744eb54fec99e52aea4, type: 2}
  simulationProfile: {fileID: 11400000, guid: 8ea561c01b3def14d8469be76bbeeebc, type: 2}
  lifecycleStages:
  - Spores land on wet leaves.
  - They infect through the pores underneath.
  - Yellow spots form, orange spores below.
  - Wind and rain spread new spores.
  conditionFactors:
  - Rainy season.
  - "21-25 \xB0C."
  - Heavy fruit load.
  - Susceptible Arabica varieties.
  referencePhotos:
  - {fileID: 2800000, guid: 84b24c5a55f4b19418f798f58526dafc, type: 3}
  lesionLabel: Orange spores
  haloLabel: Yellow spot
  areaLabel: Rusted leaf
