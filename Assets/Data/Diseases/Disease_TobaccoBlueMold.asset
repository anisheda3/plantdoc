  m_Script: {fileID: 11500000, guid: 2925bd0c6a5ea9a4fbbc9ab434791dc5, type: 3}
  m_Name: Disease_TobaccoBlueMold
  m_EditorClassIdentifier: 
  diseaseId: blue_mold
  diseaseName: Blue Mold
  aiLabelAliases:
  - tobacco_blue_mold
  - tobacco blue mold
  pathogenType: 6
  pathogen: Peronospora tabacina
  affectedPart: 0
  sources:
  - 'PlantSeg (Wei et al. 2024, CC BY 4.0) class: tobacco blue mold'
  - 'Content: general plant-pathology knowledge (APS disease compendia, university
    extension guides, UC IPM); not reviewed by a plant pathologist.'
  description: A water-mould disease of tobacco leaves that can spread rapidly through
    a region.
  causes: Spores blow long distances on the wind; cool, wet, cloudy weather favours
    infection.
  effectOnPlant: Leaves are destroyed; seedbeds can be wiped out.
  untreatedOutcome: Regional epidemics can ruin crops.
  symptoms:
  - Yellow spots on the upper leaf
  - Blue-grey downy spores on the underside
  - Spots merge, leaves pucker and die
  supportingFeatureIds:
  - leaf_spots
  - leaf_color
  - yellowing
  moderateSeverityThreshold: 0.35
  severeSeverityThreshold: 0.7
  treatmentPlan: {fileID: 11400000, guid: 692b3e75a24e443469240364b5cbabe1, type: 2}
  preventionPlan: {fileID: 11400000, guid: a5cd054208a0ec8488e945967e1c04f9, type: 2}
  simulationProfile: {fileID: 11400000, guid: d9daec1e8e76662409a1d2376af6333e, type: 2}
  lifecycleStages:
  - Spores blow in on the wind.
  - Cool, wet weather lets them infect.
  - Yellow spots form, blue-grey spores below.
  - Spores spread across the region.
  conditionFactors:
  - "Cool (15-23 \xB0C), wet weather."
  - Cloudy days.
  - Dense seedbeds.
  - Spores arriving on the wind.
  referencePhotos:
  - {fileID: 2800000, guid: fa9c8d1dbf720c347a06391af2598dc8, type: 3}
  lesionLabel: Blue-grey mould
  haloLabel: Yellow spot
  areaLabel: Yellow patch
