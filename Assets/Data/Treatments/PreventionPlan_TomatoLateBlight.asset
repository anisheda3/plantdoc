  m_Name: PreventionPlan_TomatoLateBlight
  m_EditorClassIdentifier: 
  preventionId: tomato_late_blight_prevention
  measures:
  - category: 0
    title: Destroy cull piles and volunteers
    detail: Late blight survives on living tissue such as leftover tubers and volunteer
      plants.
  - category: 3
    title: Watch regional blight forecasts
    detail: Risk rises sharply during cool, wet periods; regional alerts give useful
      early warning.
  - category: 4
    title: Manage humidity under cover
    detail: Ventilate tunnels and greenhouses to prevent condensation on foliage.
