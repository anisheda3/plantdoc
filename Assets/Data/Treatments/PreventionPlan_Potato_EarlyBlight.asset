  m_Name: PreventionPlan_Potato_EarlyBlight
  m_EditorClassIdentifier: 
  preventionId: potato_early_blight_prevention
  measures:
  - category: 5
    title: Rotate for three years
    detail: Don't plant potato or tomato in the same ground for three seasons.
  - category: 0
    title: Clear crop debris
    detail: The fungus survives on old haulm and leaves; remove them after harvest.
  - category: 5
    title: Use certified seed and tolerant varieties
    detail: Start clean and give the plant a head start.
  - category: 3
    title: Scout lower leaves weekly
    detail: Early spots are far easier to manage.
