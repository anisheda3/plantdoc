# Copy to .env and fill in real values for your deployment.
# Loaded automatically by main.py if python-dotenv is installed; otherwise set
# these as real environment variables on the host / container.

# Protects /v1/analyze and /v1/labels (and their deprecated unprefixed
# aliases). Leave unset only for local development on a trusted network.
PLANTDOCTOR_API_KEY=

# Requests per client IP per rolling 60s window, across all routes. 0 disables.
PLANTDOCTOR_RATE_LIMIT_PER_MINUTE=60

# Model artifacts — see inference.py's module docstring for the "how to go
# live" steps. Until these exist, /analyze always returns MODEL_UNAVAILABLE
# and Unity falls back to Demo Mode, by design.
PLANTDOCTOR_MODEL=models/plant_disease.onnx
PLANTDOCTOR_LABELS=models/labels.json
PLANTDOCTOR_INPUT_SIZE=224